#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT Scene;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D Output;
struct Triangle { vec4 A; vec4 B; vec4 C; vec4 Albedo; vec4 Emission; };
layout(set = 0, binding = 2, std430) readonly buffer Geometry { Triangle Triangles[]; };
layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D Diffuse;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D NormalRoughness;
layout(set = 0, binding = 5, rgba32f) uniform writeonly image2D ViewZ;
layout(set = 0, binding = 6, rgba32f) uniform writeonly image2D SurfaceAlbedo;
layout(set = 0, binding = 7, rgba32f) uniform writeonly image2D SurfaceEmission;
layout(set = 0, binding = 8, rgba32f) uniform writeonly image2D Motion;
layout(push_constant) uniform Parameters {
    mat4 InverseViewProjection;
    vec4 Environment;
    uvec4 SizeSequenceBounces;
    uvec4 Options;
    vec4 ViewDepth;
};

uint Hash(uint value) {
    value ^= value >> 16; value *= 0x7feb352du;
    value ^= value >> 15; value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

float Random(inout uint state) {
    state = Hash(state + 0x9e3779b9u);
    return (state >> 8) * (1.0 / 16777216.0);
}

vec3 Hemisphere(vec3 normal, inout uint state) {
    float radius = Random(state), angle = 6.28318530718 * Random(state);
    vec3 tangent = normalize(cross(abs(normal.z) < 0.999 ? vec3(0, 0, 1) : vec3(0, 1, 0), normal));
    return normalize(tangent * (sqrt(radius) * cos(angle)) + cross(normal, tangent) * (sqrt(radius) * sin(angle)) + normal * sqrt(1 - radius));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;

    if (any(greaterThanEqual(pixel, SizeSequenceBounces.xy))) return;

    if (Options.z != 0) {
        imageStore(Diffuse, ivec2(pixel), vec4(0)); imageStore(NormalRoughness, ivec2(pixel), vec4(0));
        imageStore(ViewZ, ivec2(pixel), vec4(1e10)); imageStore(SurfaceAlbedo, ivec2(pixel), vec4(0));
        imageStore(SurfaceEmission, ivec2(pixel), vec4(0)); imageStore(Motion, ivec2(pixel), vec4(0));
    }

    if (Options.y == 0) { imageStore(Output, ivec2(pixel), vec4(0)); return; }

    uint state = Hash(pixel.x + pixel.y * SizeSequenceBounces.x + SizeSequenceBounces.z * 747796405u);
    float jitterX = Random(state) - 0.5;
    float jitterY = Random(state) - 0.5;
    vec2 uv = (vec2(pixel) + 0.5 + ((Options.x != 0 || Options.z != 0) ? vec2(0) : vec2(jitterX, jitterY))) / vec2(SizeSequenceBounces.xy);
    vec4 nearPoint = InverseViewProjection * vec4(uv.x * 2 - 1, 1 - uv.y * 2, 0, 1);
    vec4 farPoint = InverseViewProjection * vec4(uv.x * 2 - 1, 1 - uv.y * 2, 1, 1);
    nearPoint /= nearPoint.w; farPoint /= farPoint.w;
    vec3 origin = nearPoint.xyz;
    vec3 direction = normalize(farPoint.xyz - nearPoint.xyz);
    float primaryLimit = length(farPoint.xyz - nearPoint.xyz);
    vec3 radiance = vec3(0), throughput = vec3(1), diffuse = vec3(0), diffuseThroughput = vec3(1);
    float hitDistance = 0, viewDepth = 0;
    bool primaryHit = false;
    for (uint bounce = 0; bounce < SizeSequenceBounces.w; bounce++) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, Scene, gl_RayFlagsOpaqueEXT, 255, origin, 0.0001, direction, bounce == 0 ? primaryLimit : 1e30);
        while (rayQueryProceedEXT(query)) {}
        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            radiance += throughput * Environment.xyz;
            if (bounce > 0 && Options.z != 0) { diffuse += diffuseThroughput * Environment.xyz; if (bounce == 1) hitDistance = 1e6; }
            break;
        }

        Triangle triangle = Triangles[rayQueryGetIntersectionPrimitiveIndexEXT(query, true)];
        vec3 normal = normalize(cross(triangle.B.xyz - triangle.A.xyz, triangle.C.xyz - triangle.A.xyz));
        if (dot(normal, direction) > 0) normal = -normal;
        if (bounce == 0 && Options.z != 0) {
            primaryHit = true;
            vec3 position = origin + direction * rayQueryGetIntersectionTEXT(query, true);
            viewDepth = -dot(vec4(position, 1), ViewDepth);
            vec3 octNormal = normal / (abs(normal.x) + abs(normal.y) + abs(normal.z));
            vec2 packed = vec2(octNormal.x + octNormal.y, octNormal.y - octNormal.x) * 0.5 + 0.5;
            imageStore(NormalRoughness, ivec2(pixel), vec4(packed, octNormal.z < 0 ? 0 : 1, 0));
            imageStore(ViewZ, ivec2(pixel), vec4(viewDepth));
            imageStore(SurfaceAlbedo, ivec2(pixel), vec4(triangle.Albedo.xyz, 1));
            imageStore(SurfaceEmission, ivec2(pixel), triangle.Emission);
        }

        if (bounce > 0 && Options.z != 0) {
            diffuse += diffuseThroughput * triangle.Emission.xyz;
            diffuseThroughput *= triangle.Albedo.xyz;
            if (bounce == 1) hitDistance = rayQueryGetIntersectionTEXT(query, true);
        }

        radiance += throughput * triangle.Emission.xyz;
        throughput *= triangle.Albedo.xyz;
        origin += direction * rayQueryGetIntersectionTEXT(query, true) + normal * 0.0005;
        direction = Hemisphere(normal, state);
        if (bounce >= 2) {
            float survival = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);

            if (Random(state) >= survival) break;

            throughput /= survival;
            if (Options.z != 0) diffuseThroughput /= survival;
        }
    }

    if (primaryHit) {
        diffuse = clamp(diffuse, vec3(0), vec3(65504));
        if (Options.z == 1) {
            diffuse = vec3(dot(diffuse, vec3(0.25,0.5,0.25)), dot(diffuse,vec3(0.5,0,-0.5)), dot(diffuse,vec3(-0.25,0.5,-0.25)));
            hitDistance = clamp(hitDistance / (3.0 + abs(viewDepth) * 0.1), 0.0, 1.0);
        }

        imageStore(Diffuse, ivec2(pixel), vec4(diffuse, min(hitDistance, 65504)));
    }

    imageStore(Output, ivec2(pixel), vec4(radiance, 1));
}
