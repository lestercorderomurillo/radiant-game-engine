<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="eng/Radiant.Desktop.props" />
  <PropertyGroup>
    <Version>0.4.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep field/property documentation optional; validate all XML comments. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The docs site's node_modules and the DocGen tool are separate projects. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);docs/site/**;tools/**</DefaultItemExcludes>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Radiant.Tests" />
    <InternalsVisibleTo Include="Radiant.Scenes" />
    <EmbeddedResource Include="Content/branding/radiant-splash.png" LogicalName="Radiant.Branding.Splash" />
    <EmbeddedResource Include="Content/fonts/Inter-Regular.ttf" LogicalName="Radiant.Branding.Font" />
    <Compile Include="eng/Radiant.Numerics.cs" />
    <Compile Include="src/com.radiant.engine/runtime/Backends/MonoGame/**/*.cs" />
    <ProjectReference Include="src/Radiant.Core/Radiant.Core.csproj" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.4" />
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="$(MonoGameVersion)" />
    <MonoGameContentReference Include="Content/Content.mgcb" />
    <Content Include="Native/oidn/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Content/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
