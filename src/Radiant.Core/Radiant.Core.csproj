<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.9.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="radiant" />
    <InternalsVisibleTo Include="Radiant.Tests" />
    <Compile Include="../../eng/Radiant.Numerics.cs" />
    <Compile Include="../com.radiant.engine/**/*.cs"
             Exclude="../com.radiant.engine/tests/**/*.cs;../com.radiant.engine/runtime/Backends/MonoGame/**/*.cs" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>
</Project>
